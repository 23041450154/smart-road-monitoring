[Unit]
Description=Smart Road Monitoring Autonomous Round-Robin Traffic Worker
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/capstone
Environment=PYTHONPATH=/root/capstone/backend:/root/capstone
Environment=ROUND_ROBIN_DURATION_SECONDS=120
Environment=OMP_NUM_THREADS=2
Environment=OPENVINO_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
ExecStart=/root/capstone/.venv/bin/python -m vision.traffic_worker.round_robin_worker --duration 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
