# Configure these values on the remote n8n server, not in the local app container.
# The backend URL must be reachable from that server; localhost will not point to this project.
BACKEND_API_URL=https://api.example.com
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# Required only when the remote server blocks environment access in Code/expressions.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Add provider-specific WhatsApp credentials only after a provider is selected.
# Keep tokens in the n8n credential store, not in workflow JSON or this repository.
