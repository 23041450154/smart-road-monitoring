{
  "name": "Smart Road - Commute Briefing (Telegram)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Minute Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_API_URL || 'http://localhost:8000' }}/api/routes",
        "authentication": "none",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "get-routes",
      "name": "Get Active Routes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [240, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const nowParts = new Intl.DateTimeFormat('en-GB', {\n  timeZone: 'Asia/Jakarta',\n  hour: '2-digit',\n  minute: '2-digit',\n  hour12: false,\n}).formatToParts(new Date());\nconst hour = nowParts.find((part) => part.type === 'hour')?.value ?? '';\nconst minute = nowParts.find((part) => part.type === 'minute')?.value ?? '';\nconst now = hour + ':' + minute;\nconst routes = $input.all().flatMap((item) =>\n  Array.isArray(item.json) ? item.json : [item.json],\n);\n\nreturn routes\n  .filter((route) => {\n    const fallback =\n      route.route_type === 'commute_to_work'\n        ? '06:45'\n        : route.route_type === 'commute_home'\n          ? '16:45'\n          : '';\n    const scheduledFor = String(route.notification_time || fallback).slice(0, 5);\n    return route.is_active === true && scheduledFor === now;\n  })\n  .map((route) => ({ json: route }));"
      },
      "id": "filter-due-routes",
      "name": "Filter Routes Due Now (Asia/Jakarta)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.BACKEND_API_URL || 'http://localhost:8000') + '/api/routes/' + $json.id + '/briefing' }}",
        "authentication": "none",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "get-briefing",
      "name": "Get Deterministic Briefing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [760, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $env.TELEGRAM_CHAT_ID }}\",\n  \"text\": {{ JSON.stringify($json.message) }},\n  \"parse_mode\": \"Markdown\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "send-telegram",
      "name": "Send Telegram Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1020, 0]
    },
    {
      "parameters": {
        "content": "## Telegram Credentials\nKonfigurasi variabel environment di n8n:\n- `BACKEND_API_URL`: default `http://localhost:8000`\n- `TELEGRAM_BOT_TOKEN`: Token bot Telegram dari @BotFather\n- `TELEGRAM_CHAT_ID`: ID chat atau channel Telegram penerima\n\nJangan pernah commit token ke repository git.",
        "height": 260,
        "width": 380,
        "color": 4
      },
      "id": "telegram-note",
      "name": "Telegram Setup Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [960, -200]
    }
  ],
  "connections": {
    "Every Minute Schedule": {
      "main": [[{ "node": "Get Active Routes", "type": "main", "index": 0 }]]
    },
    "Get Active Routes": {
      "main": [[{ "node": "Filter Routes Due Now (Asia/Jakarta)", "type": "main", "index": 0 }]]
    },
    "Filter Routes Due Now (Asia/Jakarta)": {
      "main": [[{ "node": "Get Deterministic Briefing", "type": "main", "index": 0 }]]
    },
    "Get Deterministic Briefing": {
      "main": [[{ "node": "Send Telegram Message", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "timezone": "Asia/Jakarta",
    "executionOrder": "v1"
  },
  "active": false,
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
